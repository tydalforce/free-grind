{
	"name": "free-grind-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "bun --watch src/main.ts",
		"start": "bun src/main.ts",
		"worker": "bun src/worker.ts",
		"db:generate": "drizzle-kit generate && bun scripts/fixMigrations.ts",
		"db:migrate": "bun src/db/migrate.ts",
		"admin:create": "bun src/cli/adminCreate.ts",
		"test": "bun test",
		"type-check": "tsc --noEmit",
		"admin:build": "cd admin && bun install && bun run build",
		"admin:dev": "cd admin && bun run dev"
	},
	"dependencies": {
		"@fastify/multipart": "9.0.3",
		"@fastify/websocket": "^11.0.2",
		"bullmq": "5.61.0",
		"drizzle-orm": "^0.44.5",
		"fastify": "^5.6.1",
		"fastify-plugin": "^5.0.1",
		"ioredis": "^5.8.0",
		"jose": "^6.1.0",
		"lru-cache": "^11.2.2",
		"ngeohash": "^0.6.3",
		"nodemailer": "6.10.1",
		"postgres": "^3.4.7",
		"prom-client": "15.1.3",
		"sharp": "0.34.4",
		"ws": "8.18.3",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"@types/ngeohash": "^0.6.8",
		"@types/nodemailer": "6.4.17",
		"@types/ws": "8.18.1",
		"drizzle-kit": "^0.31.5",
		"typescript": "^5.9.3"
	}
}
