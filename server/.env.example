# --- Core ---
NODE_ENV=development
PORT=8080
# Public base URLs the app talks to (used for signed media URLs, OAuth redirects, assignments)
PUBLIC_API_URL=http://localhost:8080
# Media domain in production (e.g. https://media.example.org). "auto" = links follow the host of each request (local dev: 127.0.0.1, localhost, LAN IP).
# Behind the local Caddy (LOCAL-TLS.md): PUBLIC_API_URL=https://api.freegrind.test, PUBLIC_MEDIA_URL=https://media.freegrind.test
PUBLIC_MEDIA_URL=auto

# 32+ random bytes, base64. Encrypts secrets stored in server_settings.
# Generate with: openssl rand -base64 48 (required in production, min. 32 chars)
APP_SECRET=change-me-to-a-long-random-string

# --- Data stores ---
DATABASE_URL=postgres://freegrind:freegrind@localhost:6432/freegrind
# Optional read replica; falls back to DATABASE_URL
DATABASE_READ_URL=
# Direct (non-pgbouncer) URL for migrations
DATABASE_MIGRATION_URL=postgres://freegrind:freegrind@localhost:5432/freegrind
REDIS_URL=redis://localhost:6379

# --- Sessions ---
# Session JWT lifetime in seconds (short so flag/entitlement changes land quickly)
SESSION_TTL_SECONDS=1800

# --- Security ---
# Set to false only for local debugging with curl
ENFORCE_SECURITY_HEADERS=true
ENFORCE_DEVICE_BINDING=true

# --- Object storage (S3-compatible; local: SeaweedFS from docker-compose) ---
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=freegrind-media
S3_ACCESS_KEY_ID=freegrind
S3_SECRET_ACCESS_KEY=freegrind-secret
